 {"bash": "rsync -a data/ /Volumes/backup/data/", "expect": "allowed", "note": "no delete option"},
 {"bash": "find data -name '*.json'", "expect": "allowed"},
 {"bash": "find . -name '*.pyc' -delete", "cwd": "{SCRATCH}", "expect": "allowed"},
 {"bash": "git clean -fd", "expect": "allowed", "note": "without -x it leaves ignored folders alone"},
