 {"group": "must not be refused"},
 {"bash": "git commit -m \"guard: refuse rm -rf data/ and artists/\"", "expect": "allowed"},
 {"bash": "git -C {ROOT}/Sibling commit -m 'rm data/ is refused'", "expect": "allowed"},
