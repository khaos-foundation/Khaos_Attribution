 {"group": "find: -delete and -depth ignore a prune; -exec without them honours it"},
 {"bash": "find . -path ./data -prune -o -name '*.pyc' -exec rm {} +", "cwd": "{REPO}", "expect": "allowed", "note": "a prune holds for -exec in the usual order"},
