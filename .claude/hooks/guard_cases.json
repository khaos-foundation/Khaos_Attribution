 {"bash": "cat > {SCRATCH}/note.md <<'EOF'\nnever run rm -rf data/ here\nEOF", "expect": "allowed"},
 {"bash": "cat <<EOF > notes.txt\nrm -rf data/ and outputs/\nEOF", "expect": "allowed"},
 {"bash": "git commit -F - <<'EOF'\nguard: rm data/ is refused\n\nIt's (a) note, isn't it\nEOF", "expect": "allowed"},
 {"bash": "git commit -m \"$(cat <<'EOF'\nguard: rm -rf data/ isn't allowed (ever)\nEOF\n)\"", "expect": "allowed"},
 {"bash": "gh pr create --title \"guard\" --body \"refuses rm -rf data/, find -delete in artists/ and git clean -x\"", "expect": "allowed"},
 {"bash": "grep -rn \"rm -rf\" docs/ data/", "expect": "allowed"},
 {"bash": "git log --grep 'rm data/'", "expect": "allowed"},
