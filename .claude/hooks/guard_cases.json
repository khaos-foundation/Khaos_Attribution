 {"bash": "find . -depth -path ./data -prune -o -name '*.pyc' -exec rm {} +", "cwd": "{REPO}", "expect": "refused"},
 {"bash": "find -d . -path ./data -prune -o -name '*.pyc' -exec rm {} +", "cwd": "{REPO}", "expect": "refused"},
 {"bash": "find . -name data -prune -o -name '*.pyc' -delete", "cwd": "{REPO}", "expect": "refused"},
 {"bash": "find . ! -name data -name '*.pyc' -delete", "cwd": "{REPO}", "expect": "refused", "note": "the guard does not credit a negation: it cannot verify what the negation spares"},
 {"bash": "find . -not -path ./data -name '*.pyc' -exec rm {} +", "cwd": "{REPO}", "expect": "refused", "note": "only a prune is credited for an -exec, not a negation"},
