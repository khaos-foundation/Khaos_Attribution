    "bpm": [
      30,
      300
    ],
    "takes": [
      1,
      16
    ]
  },
  "rework_modes": [
    "retake",
    "repaint",
    "extend",
    "audio2audio"
  ],
  "adapter": {
    "type": "mock",
    "filenames": [
      "adapter_model.safetensors"
    ],
    "resumable": true
  },
  "latent_fps": 25,
  "measure": {
    "feature_version": "mock/1"
