{
  "schema_version": "1",
  "id": "mock",
  "name": "mock-engine 1.0",
  "version": "1.0",
  "code": {
    "repo": "khaos_attribution.engines.mock"
  },
  "licence": {
    "name": "MIT"
  },
  "weights": [],
  "platforms": {
    "cuda": [
      "train",
      "render",
      "measure"
    ],
    "mps": [
      "train",
      "render",
      "measure"
    ],
    "cpu": [
      "train",
      "render",
      "measure"
    ]
  },
  "conditioning": {
    "tempo": true,
    "key": true,
    "time_signature": true,
    "lyrics": true,
    "vocal_language": true,
    "trigger": true,
    "duration": true
  },
  "sings": true,
  "sample_rate": 48000,
  "vocal_languages": {
    "en": "English",
    "es": "Spanish",
    "fr": "French",
    "de": "German",
    "it": "Italian",
    "pt": "Portuguese",
    "ja": "Japanese",
    "ko": "Korean",
    "zh": "Chinese"
  },
  "default_vocal_language": "en",
  "variants": {
