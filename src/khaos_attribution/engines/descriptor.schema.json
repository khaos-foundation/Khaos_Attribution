{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Khaos engine descriptor",
  "description": "What a base-model engine is and what it can do, as data: read by both rooms, pinned by the Engine Room.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "licence",
    "weights",
    "platforms",
    "conditioning",
    "sings",
    "sample_rate",
    "variants",
    "default_variant",
    "adapter_strength",
    "bounds",
    "rework_modes",
    "adapter",
    "measure"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "The engine half of base_model_id."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_note": {
          "type": "string"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repo"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "gated": {
            "type": "boolean"
          },
          "gated_by": {
            "type": "string"
          },
          "size_gb": {
            "type": "number"
          },
          "runtime": {
            "type": "string",
            "enum": [
              "torch",
              "mlx"
            ],
            "description": "only this runtime needs the set"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "only these paths of the repo are fetched"
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "train",
            "render",
            "measure"
          ]
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "boolean"
        },
        "key": {
          "type": "boolean"
        },
        "time_signature": {
          "type": "boolean"
        },
        "lyrics": {
          "type": "boolean"
        },
        "vocal_language": {
          "type": "boolean"
        },
        "trigger": {
          "type": "boolean"
        },
        "duration": {
          "type": "boolean"
        }
      }
    },
    "sings": {
      "type": "boolean"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000
    },
    "vocal_languages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "default_vocal_language": {
      "type": "string"
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "render"
        ],
        "properties": {
          "config": {
            "type": "string"
          },
          "render": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean"
              ]
            }
          },
          "step_clamp": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "short lines a room may show about rendering on this variant"
          }
        }
      }
    },
    "default_variant": {
      "type": "string"
    },
    "adapter_strength": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "the default artist strength both rooms apply; stated, never assumed"
    },
    "render_setting_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bounds": {
      "type": "object",
      "description": "Each lever's [low, high]; steps may instead be set per variant, as {variant: [low, high]} naming every variant.",
      "properties": {
        "steps": {
          "oneOf": [
            {
              "$ref": "#/$defs/bound"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/bound"
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/bound"
      }
    },
    "rework_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "filenames"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "filenames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumable": {
          "type": "boolean"
        }
      }
    },
    "latent_fps": {
      "type": "number"
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_version"
      ],
      "properties": {
        "feature_version": {
          "type": "string"
        },
        "timestep_convention": {
          "type": "string"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resident_gb",
        "yielded_gb"
      ],
      "description": "Measured on the engine: what it holds while serving, what it holds with its models released, and the scorer's peak by output length on CUDA under scorer, on another device type under scorer_<device>; a device with no block is refused, not guessed.",
      "properties": {
        "resident_gb": {
          "type": "number"
        },
        "yielded_gb": {
          "type": "number"
        },
        "scorer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_gb",
            "gb_per_sec",
            "checkpointed_gb",
            "checkpointed_gb_per_sec",
            "process_gb"
          ],
          "properties": {
            "base_gb": {
              "type": "number"
            },
            "gb_per_sec": {
              "type": "number"
            },
            "checkpointed_gb": {
              "type": "number"
            },
            "checkpointed_gb_per_sec": {
              "type": "number"
            },
            "process_gb": {
              "type": "number"
            }
          }
        }
      },
      "patternProperties": {
        "^scorer_(mps|cpu|xpu)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_gb",
            "gb_per_sec",
            "checkpointed_gb",
            "checkpointed_gb_per_sec",
            "process_gb"
          ],
          "properties": {
            "base_gb": {
              "type": "number"
            },
            "gb_per_sec": {
              "type": "number"
            },
            "checkpointed_gb": {
              "type": "number"
            },
            "checkpointed_gb_per_sec": {
              "type": "number"
            },
            "process_gb": {
              "type": "number"
            }
          }
        }
      }
    },
    "train": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      },
      "description": "The engine's own training defaults, applied over a Khaos recipe when a run names this engine: learning_rate, adapter_rank, adapter_alpha, adapter_type and any other value its trainer takes."
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "experimental"
      ],
      "description": "experimental: offered for trial and labelled so wherever the base model is named"
    },
    "status_note": {
      "type": "string"
    }
  },
  "$defs": {
    "bound": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[low, high]"
    }
  }
}
