{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khaos-foundation/Khaos_Attribution/schemas/attribution_estimate.schema.json",
  "title": "Attribution Estimate",
  "description": "An ESTIMATE of how much each training track influenced one generated output, and the writer/publisher splits that follow from it. This document is a methodology-stamped estimate with uncertainty ranges, never a legal statement of ownership. It never replaces the provenance record; it rides alongside it.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "artist_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "object",
      "description": "Exactly how this estimate was computed — an estimate without its method is a rumour.",
      "properties": {
        "estimator_version": {
          "type": "string",
          "minLength": 1
        },
        "exposure_basis": {
          "type": "string",
          "description": "What the exposure prior counts, e.g. 'training segments per track'."
        },
        "embedding_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "similarity_informative": {
          "type": "boolean",
          "description": "False when the acoustic similarity spread across tracks was below the noise floor, in which case blended shares equal the exposure prior (clap_blend), or when no resemblance block was read (dtrak)."
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "description": "Softmax temperature used to turn similarity scores into weights; null when similarity was uninformative."
        },
        "kind": {
          "type": "string",
          "enum": [
            "clap_blend",
            "dtrak",
            "group_removal"
          ],
          "description": "clap_blend: exposure prior corrected by CLAP resemblance (the default). dtrak: measured influence from the D-TRAK kernel over the adapter's gradient index; then blended_share_pct is the influence share and similarity_informative describes the resemblance block, if any. group_removal: the piece's loss under the served adapter and under one adapter per writer split pattern trained without that pattern's tracks; its rows are groups, and influence is not required."
        }
      },
      "required": [
        "estimator_version",
        "exposure_basis",
        "similarity_informative"
      ],
      "additionalProperties": true
    },
    "influence": {
      "type": "array",
      "description": "Per-track influence estimates, percentages of the output. Blended shares plus nothing else sum to 100.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "exposure_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "similarity_share_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "blended_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "share_range_pct": {
            "type": "array",
            "description": "[low, high] — the disagreement interval across methods. A number outside this range is a claim no method made.",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 2,
            "maxItems": 2
          },
          "influence_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "The measured influence share (method.kind dtrak); equal to blended_share_pct on such a document."
          }
        },
        "required": [
          "track_id",
          "exposure_share_pct",
          "similarity_share_pct",
          "blended_share_pct",
          "share_range_pct"
        ],
        "additionalProperties": false
      }
    },
    "splits": {
      "type": "object",
      "description": "The money math: each party's estimated share of this output, from track influence × their share of each track.",
      "properties": {
        "writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        },
        "publishers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        },
        "unattributed_pct": {
          "type": "number",
          "description": "Influence attributable to tracks with no rights record. Reported, never silently renormalised away.",
          "minimum": 0,
          "maximum": 100
        },
        "masters": {
          "type": "array",
          "description": "Recording-owner shares of the output, when any influencing track carries a masters pool.",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        }
      },
      "required": [
        "writers",
        "publishers",
        "unattributed_pct"
      ],
      "additionalProperties": false
    },
    "caveats": {
      "type": "array",
      "description": "Everything the reader must know before quoting a number, in plain sentences.",
      "items": {
        "type": "string"
      }
    },
    "resemblance": {
      "type": "object",
      "description": "On a dtrak document: the CLAP resemblance reading kept beside influence, with how far the two splits agree. Resemblance is not influence."
    },
    "base_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*@[a-z0-9][a-z0-9._-]*$",
      "description": "The base model the measured index belongs to, <engine>@<variant>."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "group_removal only: each writer split group's share of the piece, in percent, summing to 100.",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "track_ids",
          "share_pct"
        ],
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^g[1-9][0-9]*$"
          },
          "track_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "titles": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "artist_id",
    "adapter_version",
    "created_at",
    "method",
    "splits",
    "caveats"
  ],
  "additionalProperties": false,
  "$defs": {
    "party_split": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "share_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "share_range_pct": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "name",
        "share_pct",
        "share_range_pct"
      ],
      "additionalProperties": false
    },
    "dtrak_method": {
      "type": "object",
      "description": "A dtrak estimate's method from schema 1.3.0: what the money's split was read with, and the error it travels with.",
      "properties": {
        "kind": {
          "const": "dtrak"
        },
        "estimator_version": {
          "type": "string"
        },
        "exposure_basis": {
          "type": "string"
        },
        "embedding_model": {},
        "embedding_version": {},
        "similarity_informative": {
          "type": "boolean"
        },
        "temperature": {},
        "feature_target": {
          "type": "string"
        },
        "lambda_multiple": {
          "type": "number"
        },
        "lambda": {
          "type": "number"
        },
        "projection_dim": {
          "type": "integer"
        },
        "timesteps": {
          "type": "array"
        },
        "noise_seed": {},
        "n_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "n_tracks": {
          "type": "integer",
          "minimum": 0
        },
        "index_sha256": {
          "type": "string"
        },
        "adapter_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "measured_error_pp": {
          "type": [
            "number",
            "null"
          ],
          "description": "The error, in percentage points, every share travels with."
        },
        "validation": {
          "type": [
            "object",
            "null"
          ]
        },
        "calibrated": {
          "type": "boolean"
        },
        "abstention": {
          "type": "object",
          "description": "The abstention reading, when one was taken."
        },
        "calibration": {
          "type": "object",
          "description": "The calibration block, applied or the reason it was not."
        }
      },
      "required": [
        "kind",
        "estimator_version",
        "exposure_basis",
        "similarity_informative",
        "feature_target",
        "lambda",
        "n_pairs",
        "n_tracks",
        "index_sha256",
        "measured_error_pp",
        "validation",
        "calibrated"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "properties": {
              "kind": {
                "const": "group_removal"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "groups"
        ],
        "properties": {
          "schema_version": {
            "const": "1.2.0"
          }
        }
      },
      "else": {
        "required": [
          "influence"
        ],
        "not": {
          "required": [
            "groups"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3.0"
          },
          "method": {
            "properties": {
              "kind": {
                "const": "dtrak"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "schema_version",
          "method"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "$ref": "#/$defs/dtrak_method"
          }
        }
      }
    }
  ]
}
